# Copy to kit.env and fill in. install.sh puts these values into the agents, skill,
# house rules and scripts. No quotes or backslashes inside values.

# --- You
NAME="Jane Doe"
FIRST_NAME="Jane"
# Prefix of every tailored resume file: cv-jane-doe-acme-swe-intern.pdf
CV_PREFIX="cv-jane-doe"
# Second line of the email sign-off (no links: Gmail drafts mangle them)
SIGNOFF_TAGLINE="CS @ State University"
# How Grok should picture you when it writes cold emails
ABOUT_YOU="a 20 year old computer science student"
# Handles and personal domains to redact before your resume goes to Grok (comma-separated).
# Emails, phone numbers, street addresses, LinkedIn and GitHub URLs are always redacted.
# Leave this empty only if you have no other handles or site on your resume.
REDACT_TERMS="janedoe.dev,jdoe-gh"

# --- Search
TERM="Summer 2027"
TRACKS="Technical PM, Full-Stack SWE, Forward Deployed Engineer"
PREFERRED_AREAS="New York and Seattle first, then the Bay Area; anywhere in the US; remote OK"

# --- Paths
CAREER_OPS="~/career-ops"
# Your own (private) repo for scripts, templates, .env and the filed applications
DATA_REPO="~/job-search-data"
# Your master LaTeX resume (the kit only ever copies it, never edits it)
MASTER_TEX="~/resume/resume.tex"
RESUME_DIR="~/resume"

# --- Google Sheet (the ID is the long part of the sheet URL between /d/ and /edit)
SHEET_ID="paste-your-sheet-id"
SHEET_TAB="Jobs"
